@model TaskManager.Models.KanbanViewModel

<section class="bg-white border border-slate-200 rounded-xl px-5 py-3.5 shadow-sm w-full">
    <form method="get" action="/Kanban" class="flex flex-wrap items-center justify-between gap-3">
        <input type="hidden" name="workspaceId" value="@Model.CurrentWorkspaceId" />
        <input type="hidden" name="search" value="@Model.FilterSearch" />

        <div class="flex items-center gap-2 text-xs font-bold text-slate-700 uppercase tracking-wide">
            <span>🌪️ Bộ lọc đa tiêu chí:</span>
        </div>

        <div class="flex flex-wrap items-center gap-3 flex-1 justify-end">
            <div class="flex items-center gap-1.5">
                <label class="text-xs font-medium text-slate-500">Người thực hiện:</label>
                <select name="assignee" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-blue-500 transition">
                    <option value="All">Tất cả thành viên</option>
                    @foreach (var u in Model.Users)
                    {
                        <option value="@u.FullName" selected="@(Model.FilterAssignee == u.FullName)">@u.FullName</option>
                    }
                </select>
            </div>

            <div class="flex items-center gap-1.5">
                <label class="text-xs font-medium text-slate-500">Độ ưu tiên:</label>
                <select name="priority" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-blue-500 transition">
                    <option value="All">Tất cả mức độ</option>
                    <option value="Urgent" selected="@(Model.FilterPriority == "Urgent")">Urgent (Khẩn cấp)</option>
                    <option value="High" selected="@(Model.FilterPriority == "High")">High (Cao)</option>
                    <option value="Medium" selected="@(Model.FilterPriority == "Medium")">Medium (Trung bình)</option>
                    <option value="Low" selected="@(Model.FilterPriority == "Low")">Low (Thấp)</option>
                </select>
            </div>

            <div class="flex items-center gap-1.5">
                <label class="text-xs font-medium text-slate-500">Nhãn:</label>
                <select id="tagFilterSelect" onchange="filterCardsClientSide()" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-blue-500 transition">
                    <option value="All">Tất cả nhãn</option>
                    <option value="Backend">Backend / API</option>
                    <option value="Frontend">Frontend / UI</option>
                    <option value="Test">Kiểm thử / Test</option>
                    <option value="Real-time">Real-time</option>
                </select>
            </div>

            <div class="flex items-center gap-1.5">
                <label class="text-xs font-medium text-slate-500">Hạn chót:</label>
                <select id="deadlineFilterSelect" onchange="filterCardsClientSide()" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs font-medium text-slate-700 focus:outline-none focus:border-blue-500 transition">
                    <option value="All">Mọi thời gian</option>
                    <option value="overdue">⚠️ Đã quá hạn chót</option>
                    <option value="ontime">✅ Đang trong hạn</option>
                </select>
            </div>

            <a href="/Kanban?workspaceId=@Model.CurrentWorkspaceId" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-600 rounded-lg text-xs font-semibold transition">
                Đặt lại
            </a>
        </div>
    </form>
</section>