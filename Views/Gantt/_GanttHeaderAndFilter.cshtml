@model TaskManager.Models.GanttViewModel

<section class="bg-white border border-slate-200 border-l-4 border-l-blue-600 rounded-xl p-5 shadow-sm flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4 w-full">
    <div>
        <h1 class="font-bold text-base text-slate-900 tracking-tight uppercase">
            LỘ TRÌNH BIỂU ĐỒ GANTT TƯƠNG TÁC
        </h1>
        <p class="text-xs text-slate-500 mt-1">
            Quản lý tiến độ dự án <strong class="text-blue-600">@Model.CurrentWorkspaceName</strong>, hỗ trợ kéo giãn lịch trình và theo dõi điểm nghẽn.
        </p>
    </div>
    <div class="flex items-center gap-2">
        <div class="flex bg-slate-100 p-1 rounded-lg border border-slate-200 text-xs font-medium text-slate-600">
            <button type="button" class="px-3 py-1.5 bg-white text-slate-900 shadow-sm rounded-md font-semibold">Ngày</button>
            <button type="button" class="px-3 py-1.5 hover:text-slate-900 rounded-md transition">Tuần</button>
            <button type="button" class="px-3 py-1.5 hover:text-slate-900 rounded-md transition">Tháng</button>
        </div>
        <a href="/Kanban?workspaceId=@Model.CurrentWorkspaceId"
           class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-semibold shadow-sm transition">
            + Thêm mốc công việc
        </a>
    </div>
</section>

<section class="bg-white border border-slate-200 rounded-xl px-5 py-3 shadow-sm w-full flex flex-wrap items-center justify-between gap-4">
    <form method="get" action="/Gantt" class="flex items-center gap-3">
        <input type="hidden" name="workspaceId" value="@Model.CurrentWorkspaceId" />
        <input type="text" name="search" value="@Model.FilterSearch" placeholder="🔍 Lọc theo tên task..."
               class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs w-56 focus:outline-none focus:border-blue-500 transition" />
        <select name="status" onchange="this.form.submit()" class="bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5 text-xs text-slate-700 focus:outline-none focus:border-blue-500">
            <option value="All">Tất cả trạng thái</option>
            <option value="To-do" selected="@(Model.FilterStatus == "To-do")">Cần làm (To-do)</option>
            <option value="In Progress" selected="@(Model.FilterStatus == "In Progress")">Đang thực hiện</option>
            <option value="Review" selected="@(Model.FilterStatus == "Review")">Chờ duyệt (Review)</option>
            <option value="Done" selected="@(Model.FilterStatus == "Done")">Hoàn thành (Done)</option>
        </select>
        <button type="submit" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-900 text-white rounded-lg text-xs font-semibold transition">Lọc</button>
    </form>

    <div class="flex items-center gap-2 text-xs font-medium text-slate-600">
        <button type="button" onclick="toggleCriticalPath()" id="btnCriticalPath"
                class="px-3 py-1.5 border border-slate-200 bg-slate-50 hover:bg-slate-100 rounded-lg transition">
            🔗 Critical Path: Bật/Tắt
        </button>
        <button type="button" onclick="alert('Đã khóa mốc tiến độ cơ sở (Baseline) hiện tại!')"
                class="px-3 py-1.5 border border-slate-200 bg-slate-50 hover:bg-slate-100 rounded-lg transition">
            🔒 Khóa tiến độ (Baseline)
        </button>
    </div>
</section>

@if (Model.OverdueTasks > 0)
{
    <div class="bg-rose-50 border border-rose-200 rounded-xl px-5 py-3 flex items-center justify-between w-full shadow-sm">
        <div class="text-xs font-semibold text-rose-800 flex items-center gap-2">
            <span class="px-2 py-0.5 bg-rose-600 text-white text-[10px] rounded uppercase">Cảnh báo đỏ</span>
            <span>Dự án đang có <strong>@Model.OverdueTasks công việc trễ hạn</strong>, có thể ảnh hưởng đến đường găng (Critical Path).</span>
        </div>
        <button type="button" onclick="toggleCriticalPath(true)"
                class="px-3 py-1.5 bg-white border border-rose-200 text-rose-700 hover:bg-rose-100 rounded-lg text-xs font-bold transition shadow-sm">
            Xử lý nhanh
        </button>
    </div>
}