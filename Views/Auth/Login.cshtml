@model TaskManager.Models.AuthViewModel
@{
    Layout = null; // Trang Đăng nhập/Đăng ký không dùng Sidebar của _Layout
    bool isRegister = Model?.ActiveTab == "register";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập & Đăng ký - TaskWeb</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 font-sans antialiased min-h-screen flex flex-col justify-between selection:bg-blue-100 selection:text-blue-900">

    <!-- ==================== HEADER TRÊN CÙNG (THEO ĐÚNG WIREFRAME) ==================== -->
    <header class="h-16 bg-white border-b border-slate-200 px-6 lg:px-12 flex items-center justify-between shadow-2xs">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
                T
            </div>
            <span class="font-bold text-lg tracking-tight text-slate-900">TaskWeb</span>
        </a>

        <nav class="flex items-center gap-6 text-xs font-medium text-slate-600">
            <a href="#features" class="hover:text-blue-600 transition">Tính năng</a>
            <a href="/swagger" class="hover:text-blue-600 transition">Tài liệu API</a>
            <a href="#help" class="hover:text-blue-600 transition">Trợ giúp</a>
        </nav>
    </header>

    <!-- ==================== CARD TRUNG TÂM (ĐĂNG NHẬP / ĐĂNG KÝ) ==================== -->
    <main class="flex-1 flex items-center justify-center p-6">
        <div class="bg-white border border-slate-200 rounded-2xl shadow-lg w-full max-w-[440px] p-8 sm:p-10 transition-all">

            <!-- Thông báo lỗi / thành công -->
            @if (!string.IsNullOrEmpty(Model?.ErrorMessage))
            {
                <div class="mb-5 p-3.5 bg-rose-50 border border-rose-200 rounded-xl text-xs font-semibold text-rose-700 flex items-center gap-2">
                    <span>⚠️</span>
                    <span>@Model.ErrorMessage</span>
                </div>
            }
            @if (!string.IsNullOrEmpty(Model?.SuccessMessage))
            {
                <div class="mb-5 p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl text-xs font-semibold text-emerald-700 flex items-center gap-2">
                    <span>✅</span>
                    <span>@Model.SuccessMessage</span>
                </div>
            }

            <!-- ==================== FORM 1: ĐĂNG NHẬP TASKWEB ==================== -->
            <div id="loginBox" class="@(isRegister ? "hidden" : "block")">
                <div class="text-center mb-7">
                    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                        Đăng nhập TaskWeb
                    </h1>
                    <p class="text-xs text-slate-500 mt-2 leading-relaxed px-2">
                        Chào mừng bạn quay trở lại với không gian làm việc của dự án
                    </p>
                </div>

                <form method="post" action="/Auth/Login" class="space-y-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">
                            Email công việc
                        </label>
                        <input type="email" name="Email" value="@Model?.Email" required
                               placeholder="nhap.email@congty.com"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-3 focus:ring-blue-500/15 transition" />
                    </div>

                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label class="text-xs font-bold text-slate-700">Mật khẩu</label>
                            <a href="javascript:void(0)" onclick="alert('Vui lòng liên hệ Project Owner để đặt lại mật khẩu!')"
                               class="text-xs font-semibold text-blue-600 hover:text-blue-700">
                                Quên mật khẩu?
                            </a>
                        </div>
                        <input type="password" name="Password" required
                               placeholder="Nhập mật khẩu..."
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-3 focus:ring-blue-500/15 transition" />
                    </div>

                    <div class="flex items-center gap-2 pt-1">
                        <input type="checkbox" id="rememberMe" name="RememberMe" value="true"
                               class="w-4 h-4 rounded border-slate-300 text-blue-600 focus:ring-blue-500 cursor-pointer" />
                        <label for="rememberMe" class="text-xs text-slate-600 cursor-pointer select-none">
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <button type="submit"
                            class="w-full py-2.5 bg-slate-900 hover:bg-blue-600 text-white font-bold text-xs rounded-xl shadow-sm transition duration-150 cursor-pointer">
                        Đăng nhập
                    </button>
                </form>

                <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
                    Chưa có tài khoản <strong class="text-slate-700">TaskWeb</strong>?
                    <button type="button" onclick="switchAuthMode('register')"
                            class="font-bold text-blue-600 hover:text-blue-700 hover:underline ml-1">
                        Đăng ký ngay
                    </button>
                </div>
            </div>

            <!-- ==================== FORM 2: ĐĂNG KÝ TÀI KHOẢN MỚI ==================== -->
            <div id="registerBox" class="@(isRegister ? "block" : "hidden")">
                <div class="text-center mb-6">
                    <h1 class="text-2xl font-extrabold text-slate-900 tracking-tight">
                        Đăng ký TaskWeb
                    </h1>
                    <p class="text-xs text-slate-500 mt-1.5 leading-relaxed">
                        Tạo tài khoản mới để tham gia quản lý tiến độ dự án cùng đội nhóm
                    </p>
                </div>

                <form method="post" action="/Auth/Register" class="space-y-3.5">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Họ và tên
                        </label>
                        <input type="text" name="FullName" value="@Model?.FullName" required maxlength="100"
                               placeholder="Ví dụ: Nguyễn Văn Thành Đạt"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-3 focus:ring-blue-500/15 transition" />
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Email công việc
                        </label>
                        <input type="email" name="Email" value="@Model?.Email" required
                               placeholder="nhap.email@congty.com"
                               class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 focus:ring-3 focus:ring-blue-500/15 transition" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Mật khẩu
                            </label>
                            <input type="password" name="Password" required minlength="6"
                                   placeholder="Tối thiểu 6 ký tự..."
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 transition" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">
                                Xác nhận mật khẩu
                            </label>
                            <input type="password" name="ConfirmPassword" required minlength="6"
                                   placeholder="Nhập lại mật khẩu..."
                                   class="w-full px-3.5 py-2.5 text-xs bg-slate-50/70 border border-slate-300 rounded-xl text-slate-800 placeholder-slate-400 focus:outline-none focus:bg-white focus:border-blue-600 transition" />
                        </div>
                    </div>

                    <button type="submit"
                            class="w-full py-2.5 mt-2 bg-blue-600 hover:bg-blue-700 text-white font-bold text-xs rounded-xl shadow-sm transition duration-150 cursor-pointer">
                        Tạo tài khoản
                    </button>
                </form>

                <div class="mt-6 pt-5 border-t border-slate-100 text-center text-xs text-slate-500">
                    Đã có tài khoản <strong class="text-slate-700">TaskWeb</strong>?
                    <button type="button" onclick="switchAuthMode('login')"
                            class="font-bold text-blue-600 hover:text-blue-700 hover:underline ml-1">
                        Đăng nhập
                    </button>
                </div>
            </div>

        </div>
    </main>

    <!-- ==================== FOOTER DƯỚI ĐÁY (THEO ĐÚNG WIREFRAME) ==================== -->
    <footer class="bg-white border-t border-slate-200 px-6 lg:px-12 py-4 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs text-slate-400">
        <div>
            © 2026 TaskWeb Inc. Mọi quyền được bảo lưu.
        </div>
        <div class="flex items-center gap-3">
            <a href="#terms" class="hover:text-slate-600 transition">Điều khoản sử dụng</a>
            <span>•</span>
            <a href="#privacy" class="hover:text-slate-600 transition">Chính sách bảo mật</a>
            <span>•</span>
            <a href="#support" class="hover:text-slate-600 transition">Liên hệ hỗ trợ</a>
        </div>
    </footer>

    <script>
        function switchAuthMode(mode) {
            const loginBox = document.getElementById('loginBox');
            const registerBox = document.getElementById('registerBox');
            if (mode === 'register') {
                loginBox.classList.add('hidden');
                registerBox.classList.remove('hidden');
            } else {
                registerBox.classList.add('hidden');
                loginBox.classList.remove('hidden');
            }
        }
    </script>
</body>
</html>