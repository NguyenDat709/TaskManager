@model dynamic
@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var workspaces = Model?.Workspaces as System.Collections.IEnumerable;
    int currentWsId = Model?.CurrentWorkspaceId ?? 1;
}

<aside class="w-64 bg-slate-900 text-slate-300 flex flex-col justify-between shrink-0 shadow-lg">
    <div>
        <div class="h-16 px-6 flex items-center gap-2.5 border-b border-slate-800">
            <div class="w-8 h-8 rounded-lg bg-blue-600 flex items-center justify-center text-white font-bold text-lg shadow-sm">
                T
            </div>
            <span class="font-bold text-lg tracking-tight text-white">TaskWeb</span>
        </div>

        <nav class="p-4 space-y-1.5">
            <a href="/" class="flex items-center gap-3 px-3.5 py-2.5 text-sm rounded-lg transition @(currentController == "Home" ? "font-semibold bg-blue-600 text-white shadow-sm" : "font-medium text-slate-400 hover:bg-slate-800 hover:text-white")">
                Trang chủ
            </a>
            <a href="/Kanban" class="flex items-center gap-3 px-3.5 py-2.5 text-sm rounded-lg transition @(currentController == "Kanban" ? "font-semibold bg-blue-600 text-white shadow-sm" : "font-medium text-slate-400 hover:bg-slate-800 hover:text-white")">
                Kanban
            </a>
            <a href="#checklist" class="flex items-center gap-3 px-3.5 py-2.5 text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white rounded-lg transition">
                Task & Checklist
            </a>
            <a href="/Gantt" class="flex items-center gap-3 px-3.5 py-2.5 text-sm rounded-lg transition @(currentController == "Gantt" ? "font-semibold bg-blue-600 text-white shadow-sm" : "font-medium text-slate-400 hover:bg-slate-800 hover:text-white")">
                Gantt
            </a>
            <a href="#analytics" class="flex items-center gap-3 px-3.5 py-2.5 text-sm font-medium text-slate-400 hover:bg-slate-800 hover:text-white rounded-lg transition">
                Báo cáo & Thống kê
            </a>
        </nav>

        <div class="px-4 mt-4">
            <div class="flex justify-between items-center text-[11px] font-bold text-slate-500 uppercase px-2 mb-2.5 tracking-wider">
                <span>DỰ ÁN CỦA BẠN</span>
                <span class="bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">
                    @(Model?.Workspaces != null && Model.Workspaces.Count > 0 ? Model.Workspaces.Count : 2)
                </span>
            </div>

            <div class="space-y-1.5">
                @if (Model?.Workspaces != null && Model.Workspaces.Count > 0)
                {
                    foreach (var ws in Model.Workspaces)
                    {
                        bool isActive = ws.WorkspaceID == currentWsId;
                        <a href="/@currentController?workspaceId=@ws.WorkspaceID"
                           class="flex items-center justify-between px-3 py-2 text-xs font-medium @(isActive ? "bg-slate-800 text-white border border-slate-700" : "bg-slate-800/40 text-slate-400 border border-transparent hover:bg-slate-800/70 hover:text-slate-200") rounded-lg hover:border-blue-500/50 transition cursor-pointer">
                            <span class="truncate">📁 @ws.WorkspaceName</span>
                            <span class="text-[10px] px-1.5 py-0.5 bg-blue-500/20 text-blue-300 border border-blue-500/30 rounded font-semibold">OWNER</span>
                        </a>
                    }
                }
                else
                {
                    <div class="flex items-center justify-between px-3 py-2 text-xs font-medium bg-slate-800 text-white border border-slate-700 rounded-lg">
                        <span class="truncate">📁 Thiết kế E-Commerce</span>
                        <span class="text-[10px] px-1.5 py-0.5 bg-blue-500/20 text-blue-300 rounded font-semibold">OWNER</span>
                    </div>
                    <div class="flex items-center justify-between px-3 py-2 text-xs font-medium text-slate-400 hover:bg-slate-800/50 rounded-lg transition">
                        <span class="truncate">📁 Mobile App Banking</span>
                        <span class="text-[10px] bg-slate-800 text-slate-400 px-1.5 py-0.5 rounded">MEM</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="p-4 border-t border-slate-800 space-y-2">
        <button onclick="alert('Mở popup mời thành viên qua Email / Link mời (R06)')" class="w-full py-2 px-3 bg-slate-800 hover:bg-blue-600 text-slate-200 hover:text-white border border-slate-700 hover:border-blue-500 rounded-lg text-xs font-semibold flex items-center justify-center gap-2 transition">
            <span>👤+</span> Mời thành viên
        </button>
        <a href="#settings" class="flex items-center gap-2 px-3 py-1.5 text-xs text-slate-400 hover:text-white transition">
            <span>⚙️</span> Cài đặt dự án
        </a>
    </div>
</aside>