@{
    var tasks = ViewBag.Tasks as List<TaskManager.Models.TaskItem> ?? new List<TaskManager.Models.TaskItem>();
    DateTime today = DateTime.Now;

    // View Tháng
    DateTime firstDayOfMonth = new DateTime(today.Year, today.Month, 1);
    int daysInMonth = DateTime.DaysInMonth(today.Year, today.Month);
    int startColumn = ((int)firstDayOfMonth.DayOfWeek == 0) ? 7 : (int)firstDayOfMonth.DayOfWeek;

    // View Tuần
    int diffToMonday = (7 + (int)today.DayOfWeek - 1) % 7;
    DateTime mondayOfWeek = today.AddDays(-diffToMonday);
}

<style>
    .calendar-grid {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 6px;
    }

    .calendar-day-box {
        background-color: #ffffff;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        min-height: 105px;
        padding: 6px;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

        .calendar-day-box.is-today {
            background-color: #f0f7ff;
            border: 1px solid #2563eb;
        }

    .time-slot-row {
        border-bottom: 1px dashed #e9ecef;
        min-height: 48px;
    }
</style>

<div class="card border-0 shadow-sm bg-white">
    <!-- Thanh công cụ Tháng / Tuần / Ngày -->
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-2">
        <div class="btn-group btn-group-sm" id="calModeBtnGroup">
            <button type="button" data-mode="month" class="btn btn-outline-dark cal-mode-btn active">Tháng</button>
            <button type="button" data-mode="week" class="btn btn-outline-dark cal-mode-btn">Tuần</button>
            <button type="button" data-mode="day" class="btn btn-outline-dark cal-mode-btn">Ngày</button>
        </div>
        <span class="fw-bold text-dark text-uppercase" id="calTitleText">THÁNG @today.ToString("MM, yyyy")</span>
    </div>

    <div class="card-body p-3">
        <!-- 1. CHẾ ĐỘ XEM THÁNG -->
        <div id="calMonthView">
            <div class="calendar-grid text-center fw-bold text-muted small mb-2">
                <div>THỨ 2 (T2)</div>
                <div>THỨ 3 (T3)</div>
                <div>THỨ 4 (T4)</div>
                <div class="text-primary">THỨ 5 (T5)</div>
                <div>THỨ 6 (T6)</div>
                <div>THỨ 7 (T7)</div>
                <div class="text-danger">CHỦ NHẬT (CN)</div>
            </div>

            <div class="calendar-grid">
                @for (int i = 1; i < startColumn; i++)
                {
                    <div class="calendar-day-box bg-light opacity-50"></div>
                }

                @for (int day = 1; day <= daysInMonth; day++)
                {
                    DateTime currentDate = new DateTime(today.Year, today.Month, day);
                    bool isToday = (day == today.Day);
                    var dayTasks = tasks.Where(t => t.Deadline.Date == currentDate.Date).ToList();

                    <div class="calendar-day-box @(isToday ? "is-today" : "")">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="fw-bold @(isToday ? "text-primary" : "text-dark")" style="font-size: 0.8rem;">@day</span>
                            @if (dayTasks.Any())
                            {
                                <span class="badge bg-light text-dark border" style="font-size: 0.6rem;">@dayTasks.Count task</span>
                            }
                        </div>

                        <div class="mt-1">
                            @foreach (var task in dayTasks.Take(2))
                            {
                                string badgeClass = task.Status == "Done" ? "bg-secondary" : (task.Deadline < today ? "bg-danger" : "bg-primary");
                                <div class="badge @badgeClass text-truncate w-100 text-start p-1 mb-1" style="font-size: 0.65rem;" title="@task.Title">
                                    @task.Title
                                </div>
                            }
                            @if (dayTasks.Count > 2)
                            {
                                <div class="text-muted text-end" style="font-size: 0.6rem;">+@(dayTasks.Count - 2) task nữa</div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- 2. CHẾ ĐỘ XEM TUẦN -->
        <div id="calWeekView" style="display: none;">
            <div class="calendar-grid text-center fw-bold text-muted small mb-2">
                @for (int i = 0; i < 7; i++)
                {
                    DateTime weekDay = mondayOfWeek.AddDays(i);
                    bool isToday = (weekDay.Date == today.Date);
                    <div class="p-2 rounded @(isToday ? "bg-primary text-white" : "bg-light text-dark")">
                        <div>Thứ @(i == 6 ? "CN" : (i + 2).ToString())</div>
                        <div class="fs-6">@weekDay.ToString("dd/MM")</div>
                    </div>
                }
            </div>

            <div class="calendar-grid mt-2">
                @for (int i = 0; i < 7; i++)
                {
                    DateTime weekDay = mondayOfWeek.AddDays(i);
                    var dayTasks = tasks.Where(t => t.Deadline.Date == weekDay.Date).ToList();

                    <div class="border rounded p-2 bg-light" style="min-height: 320px;">
                        @if (dayTasks.Any())
                        {
                            @foreach (var task in dayTasks)
                            {
                                string badgeClass = task.Status == "Done" ? "bg-secondary" : (task.Deadline < today ? "bg-danger" : "bg-primary");
                                <div class="card border-0 shadow-sm mb-2 p-2 bg-white text-start">
                                    <div class="fw-bold text-dark small">@task.Title</div>
                                    <small class="text-muted" style="font-size: 0.7rem;">
                                        <i class="bi bi-clock me-1"></i>@task.Deadline.ToString("HH:mm")
                                    </small>
                                    <span class="badge @badgeClass mt-1" style="font-size: 0.6rem;">@task.Status</span>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center text-muted py-4 small">Trống</div>
                        }
                    </div>
                }
            </div>
        </div>

        <!-- 3. CHẾ ĐỘ XEM NGÀY -->
        <div id="calDayView" style="display: none;">
            <div class="p-2 bg-light rounded text-center mb-3">
                <span class="fw-bold text-dark">Lịch trình ngày @today.ToString("dd/MM/yyyy")</span>
            </div>

            <div class="border rounded bg-white p-3">
                @{
                    var todayTasks = tasks.Where(t => t.Deadline.Date == today.Date).ToList();
                }

                @for (int hour = 8; hour <= 18; hour++)
                {
                    var hourTasks = todayTasks.Where(t => t.Deadline.Hour == hour).ToList();
                    <div class="d-flex align-items-center time-slot-row py-2 text-start">
                        <div class="fw-bold text-muted px-3 border-end" style="width: 80px; font-size: 0.8rem;">
                            @hour:00
                        </div>
                        <div class="flex-grow-1 ps-3">
                            @if (hourTasks.Any())
                            {
                                @foreach (var task in hourTasks)
                                {
                                    <span class="badge bg-primary px-2 py-1 me-2" style="font-size: 0.75rem;">
                                        📌 @task.Title (@task.Status)
                                    </span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small opacity-50">-- Không có lịch --</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>